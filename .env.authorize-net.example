# Authorize.Net gateway supplied through the eMerchant Authority merchant account.
# Keep live values only in the deployment provider's encrypted environment settings.
AUTHORIZE_NET_ENVIRONMENT=sandbox
AUTHORIZE_NET_API_LOGIN_ID=replace-with-api-login-id
AUTHORIZE_NET_TRANSACTION_KEY=replace-with-transaction-key
AUTHORIZE_NET_SIGNATURE_KEY=replace-with-signature-key

# Public frontend origin used for hosted-checkout return/cancel URLs.
PUBLIC_APP_URL=https://www.fantasymmadness.com

# In Authorize.Net, register this HTTPS endpoint for
# net.authorize.payment.authcapture.created events:
# https://YOUR-BACKEND-HOST/api/webhooks/authorize-net
