# Kurv Merchant hosted checkout. Confirm parameter/header names against the
# hosted-checkout documentation issued for the Fantasy MMAdness merchant account.
KURV_HOSTED_CHECKOUT_URL=https://YOUR-KURV-HOSTED-CHECKOUT-URL
KURV_WEBHOOK_SECRET=replace-with-the-kurv-webhook-signing-secret

# Enable only after Kurv confirms stored-credential/recurring billing for this
# merchant account. The one-time 30-day FM+ pass works while this stays false.
KURV_RECURRING_ENABLED=false

# Optional: enables model-written per-fight scouting reports. Without these,
# the backend uses the validated database-grounded fallback report.
OPENAI_API_KEY=
OPENAI_SCOUTING_MODEL=gpt-4o-mini

# Public web origin used for checkout returns and password-set links.
PUBLIC_APP_URL=https://www.fantasymmadness.com

# Required by account creation/login and checkout account recovery.
JWT_SECRET=replace-with-a-long-random-secret
SMTP_USER=Fantasymmadness2@gmail.com
SMTP_PASS=replace-with-mail-provider-app-password
