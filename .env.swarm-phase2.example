# Phase 2 backend -> IONOS swarm integration
SWARM_ENABLED=true
SWARM_BASE_URL=http://YOUR_IONOS_SERVER_IP:8080
SWARM_REQUEST_TIMEOUT_MS=45000

# Use the same API key configured in the Phase 1 swarm .env
SWARM_API_KEY=replace_with_swarm_api_key

# Optional but recommended for signed backend -> swarm requests
SWARM_HMAC_KEY_ID=swarm-v1
SWARM_HMAC_SECRET=replace_with_swarm_hmac_secret
SWARM_HMAC_MAX_SKEW_SECONDS=300

# Required when Phase 1 swarm callbacks are enabled
BACKEND_HMAC_KEY_ID=backend-v1
BACKEND_HMAC_SECRET=replace_with_backend_callback_hmac_secret
SWARM_WEBHOOK_REQUIRE_HMAC=true

# Safety flags. Keep false until admin review workflows are tested.
SWARM_DEFAULT_MODE=DRAFT_ONLY
SWARM_AUTO_PUBLISH_ENABLED=false
SWARM_AUTO_IMPORT_ENABLED=false
SWARM_SOCIAL_PUBLISH_ENABLED=false

# Automation safety controls used by backend event hooks/settings UI
SWARM_AUTOMATION_EVENT_HOOKS_ENABLED=true
SWARM_AUTO_PUBLISH_ENABLED=false
SWARM_AUTO_IMPORT_ENABLED=false
SWARM_SOCIAL_PUBLISH_ENABLED=false
