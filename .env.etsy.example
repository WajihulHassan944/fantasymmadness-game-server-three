# Fantasy MMAdness Etsy apparel catalog sync
# Keep these values on the server only. Never expose them in Next.js NEXT_PUBLIC_* variables.
ETSY_APPAREL_SYNC_ENABLED=true
ETSY_API_BASE_URL=https://api.etsy.com/v3/application
ETSY_SHOP_NAME=FANTASYMMADNESS
# Optional if known. If omitted, backend resolves the shop ID by ETSY_SHOP_NAME.
ETSY_SHOP_ID=
# Etsy app credentials from developer.etsy.com
ETSY_API_KEYSTRING=replace-with-keystring
ETSY_SHARED_SECRET=replace-with-shared-secret
# Optional tuning
ETSY_PRODUCTS_CACHE_TTL_MS=900000
ETSY_API_TIMEOUT_MS=12000
