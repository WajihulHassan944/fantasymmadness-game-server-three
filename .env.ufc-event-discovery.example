# Google News RSS feed used for UFC/upcoming-event discovery.
# Keep this UFC-focused query; the generic MMA feed is intentionally not used.
UFC_EVENT_DISCOVERY_RSS_URL=https://news.google.com/rss/search?q=UFC%20OR%20%22UFC%20Fight%20Night%22&hl=en-US&gl=US&ceid=US:en

# Scheduled backend refresh. Default: every 6 hours at minute 17.
UFC_EVENT_DISCOVERY_CRON_ENABLED=true
UFC_EVENT_DISCOVERY_CRON=17 */6 * * *
UFC_EVENT_DISCOVERY_TIMEZONE=America/New_York

# Optional HTTP cron protection for GET /api/cron/ufc-event-discovery.
# If unset, the route falls back to admin JWT auth.
UFC_EVENT_DISCOVERY_CRON_SECRET=replace_with_random_secret

# Quality controls.
UFC_EVENT_DISCOVERY_MAX_ITEMS=35
UFC_EVENT_DISCOVERY_MIN_CONFIDENCE=55
UFC_EVENT_DISCOVERY_REQUIRE_DATE=true
UFC_EVENT_DISCOVERY_ALLOW_PAST_DAYS=3

# Best-effort official UFC event-page enrichment when a UFC event URL is present.
UFC_EVENT_OFFICIAL_ENRICHMENT_ENABLED=true
UFC_EVENT_DISCOVERY_FETCH_TIMEOUT_MS=6500
